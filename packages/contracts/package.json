{
  "name": "@pairly/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js",
      "default": "./dist/room.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js",
      "default": "./dist/execution.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@pairly/config": "workspace:*",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
