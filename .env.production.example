# ==============================================================================
# Pairly IDE - Production Environment Configuration
# Copy this file to .env.production or set these in your hosting providers
# (e.g. Vercel for Frontend, Railway / Render for Realtime WebSocket Server)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application (Vercel / Next.js)
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

# URL of your deployed Pairly Realtime WebSocket service (Railway / Render / Fly.io)
# Example: wss://pairly-realtime.up.railway.app
NEXT_PUBLIC_REALTIME_URL="wss://realtime.yourdomain.com"

# Public site URL (used for canonical metadata, social sharing, and redirects)
NEXT_PUBLIC_APP_URL="https://pairly.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. Database & Caching (Neon / Supabase / Upstash)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with PgBouncer connection pooling for serverless
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/pairly?sslmode=require"

# Redis connection string for room state clustering and pub/sub
# Upstash Redis or managed Redis instance
REDIS_URL="rediss://default:password@sample-endpoint.upstash.io:6379"

# ------------------------------------------------------------------------------
# 3. Realtime Service (Railway / Render / Container Runner)
# ------------------------------------------------------------------------------
PORT="4001"
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 4. Code Execution (Remote Piston Engine)
# ------------------------------------------------------------------------------
# Default public endpoint falls back to https://emkc.org/api/v2/piston
# Set custom endpoint if self-hosting private Piston cluster
PISTON_URL="https://emkc.org/api/v2/piston"
PISTON_FALLBACK_URL="https://emkc.org/api/v2/piston"

# ------------------------------------------------------------------------------
# 5. AI Assistant Gateway (Anthropic & OpenAI)
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER="anthropic" # 'anthropic' | 'openai' | 'mock'
ANTHROPIC_API_KEY="sk-ant-api03-sample-key"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
OPENAI_API_KEY="sk-proj-sample-key"
OPENAI_MODEL="gpt-4o"

# ------------------------------------------------------------------------------
# 6. Audio/Video SFU (LiveKit Cloud)
# ------------------------------------------------------------------------------
# From https://cloud.livekit.io
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxx"
LIVEKIT_API_SECRET="secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
